SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Desarrollo local: PostgreSQL local con estas variables sueltas.
DB_NAME=inventarios_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Produccion (Render + Neon): en vez de las 5 variables DB_*, se define
# DATABASE_URL con el connection string que da Neon. Cuando esta variable
# existe, settings.py la usa y se ignoran las DB_* de arriba.
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/dbname?sslmode=require
